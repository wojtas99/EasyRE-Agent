#!/usr/bin/env python3
"""EasyRE-Agent - reverse engineering agent in a box.

  easyre run TARGET [options]      solve a task (file or folder under /tasks)
  easyre resume JOB [options]      continue an existing job
  easyre hint JOB                  show the next hint of a hint-mode job
  easyre tutor JOB                 continue a tutor conversation
  easyre jobs                      list jobs
  easyre profiles                  list model profiles (config/backends.toml)
  easyre open [JOB] [folder]       (host) open the newest job's report, tutor chat or folder
  easyre doctor                    check that the setup works
  easyre stats                     time, tokens and cost per model over all jobs
  easyre close JOB                 mark a job as closed (resume reopens it)
  easyre rm JOB... | --FILTER [-y] delete job folders; filters: --open --closed --unsolved --solved --all
  easyre login claude|codex        authenticate a backend
  easyre check CANDIDATE           (agent) verify a candidate answer
  easyre done                      (agent, hint mode) mark hints as finished

run/resume options:
  --desc TEXT | --desc-file FILE   task description (default: task.md / README.md in the target folder)
  --success REGEX                  output that means the answer was accepted, e.g. "Correct|Success"
  --flag-format REGEX              shape of the answer, e.g. "flag\\{.*\\}"
  --verify CMD                     command that checks a candidate ({} = candidate, otherwise sent on stdin)
  --profile NAME                   model profile from config/backends.toml
  --backend claude|codex|openai    default: claude
  --model NAME                     backend model (claude: opus/sonnet, codex: gpt-..., openai: any)
  --mode solve|hint|tutor          default: solve
  --budget-min N                   wall clock budget in minutes (default 120)
  --budget-tokens N                token budget (default: none)
  --name NAME                      job name
  --logs                           stream the agent's commands instead of a progress bar
  -i                               interactive (claude/codex TUI)
"""
