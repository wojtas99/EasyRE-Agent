    {"type": "function", "function": {"name": "bash", "description": "Run a bash command in /work (Ubuntu, root, RE tools installed). Returns combined stdout/stderr, truncated.",
     "parameters": {"type": "object", "properties": {"command": {"type": "string"}, "timeout": {"type": "integer", "description": "seconds, default 300"}}, "required": ["command"]}}},
    {"type": "function", "function": {"name": "read_file", "description": "Read a text file (optionally a line range).",
     "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "start": {"type": "integer"}, "end": {"type": "integer"}}, "required": ["path"]}}},
    {"type": "function", "function": {"name": "write_file", "description": "Write a text file (overwrites).",
     "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}}, "required": ["path", "content"]}}},
    {"type": "function", "function": {"name": "read_skill", "description": "Read a skill playbook by name. Available skills are listed in your instructions.",
     "parameters": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}}},
]
MAX_OUT = int(os.environ.get("EASYRE_TOOL_OUTPUT", "12000"))


def clip(s):
    return s if len(s) <= MAX_OUT else s[: MAX_OUT // 2] + f"\n... [{len(s) - MAX_OUT} chars cut] ...\n" + s[-MAX_OUT // 2:]


def tool_call(name, a):
    try:
        if name == "bash":
            r = subprocess.run(["bash", "-lc", a["command"]], cwd=WORK, capture_output=True, text=True,
                               timeout=int(a.get("timeout") or 300), errors="replace")
            return clip(f"exit={r.returncode}\n{r.stdout}{r.stderr}")
        if name == "read_file":
            lines = Path(a["path"]).read_text(errors="replace").splitlines()
            s, e = int(a.get("start") or 1), int(a.get("end") or len(lines))
            return clip("\n".join(f"{i}\t{l}" for i, l in enumerate(lines[s - 1:e], s)))
        if name == "write_file":
            p = Path(a["path"])
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(a["content"])
            return f"wrote {len(a['content'])} chars to {p}"
        if name == "read_skill":
            p = SKILLS / re.sub(r"[^a-z0-9-]", "", a["name"]) / "SKILL.md"
            return clip(p.read_text()) if p.exists() else "no such skill"
    except subprocess.TimeoutExpired:
        return "timeout: command killed (run long jobs in the background with nohup and poll a log file)"
    except Exception as e:
        return f"error: {e!r}"
    return "unknown tool"


def chat(msgs, cfg):
    base = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1").rstrip("/")
    body = {"model": cfg.get("model") or os.environ.get("OPENAI_MODEL", "gpt-4.1"), "messages": msgs, "tools": TOOLS}
    req = urllib.request.Request(base + "/chat/completions", data=json.dumps(body).encode(), method="POST",
                                 headers={"Content-Type": "application/json", "Authorization": f"Bearer {os.environ.get('OPENAI_API_KEY', 'none')}"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.loads(r.read())


def backend_openai(cfg, prompt, t0, extra):
    hist = meta() / "openai_history.json"
    msgs = jload(hist) or [{"role": "system", "content": (meta() / "instructions.md").read_text()}, {"role": "user", "content": prompt}]
    if msgs[-1]["role"] == "assistant":
        msgs.append({"role": "user", "content": CONTINUE})
    idle = 0
    while not finished(cfg):
        why = budget_left(cfg, t0)
        if why:
            return "", why
        try:
            resp = chat(msgs, cfg)
        except Exception as e:
            msg = str(e) + (e.read().decode(errors="replace")[:400] if hasattr(e, "read") else "")
            log("api error:", msg[:300])
            return classify(msg), ""
        u = resp.get("usage") or {}
        cfg["tokens"] += int(u.get("completion_tokens") or 0)
        cfg["tokens_in"] = cfg.get("tokens_in", 0) + int(u.get("prompt_tokens") or 0)
        m = resp["choices"][0]["message"]
        msgs.append({k: v for k, v in m.items() if k in ("role", "content", "tool_calls")})
        if m.get("content"):
            activity("agent:", str(m["content"]).strip()[:400])
        calls = m.get("tool_calls") or []
        for c in calls:
            try:
                a = json.loads(c["function"].get("arguments") or "{}")
            except ValueError:
                a = {}
            activity(f"{c['function']['name']}:", str(a.get("command") or a.get("path") or a.get("name") or "")[:200])
            msgs.append({"role": "tool", "tool_call_id": c["id"], "content": tool_call(c["function"]["name"], a)})
        if not calls:
            idle += 1
            if idle > 2:
                return "", ""
            msgs.append({"role": "user", "content": "Not finished yet. " + CONTINUE + " Use the tools."})
        else:
            idle = 0
        jsave(hist, msgs)
        with open(meta() / "log.jsonl", "a") as lg:
            lg.write(json.dumps({"usage": u, "calls": len(calls)}) + "\n")
        jsave(meta() / "job.json", cfg)
    return "", ""


BACKENDS = {"claude": backend_claude, "codex": backend_codex, "openai": backend_openai}


def load_profiles():
    f = CONF / "backends.toml"
    if not f.exists():
        return {}
    try:
        return tomllib.loads(f.read_text())
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"config/backends.toml: {e}")


def apply_profile(cfg):
    name = cfg.get("profile")
    if not name:
        return
    p = (load_profiles().get("profiles") or {}).get(name)
    if p is None:
        sys.exit(f"unknown profile {name!r}; see `easyre profiles`")
    if p.get("base_url"):
        os.environ["OPENAI_BASE_URL"] = p["base_url"]
    key = os.environ.get(p["api_key_env"], "") if p.get("api_key_env") else p.get("api_key", "")
    if p.get("api_key_env") and not key:
        sys.exit(f"profile {name}: set {p['api_key_env']} in .env")
    if key:
        os.environ["OPENAI_API_KEY"] = key
    for k, v in (p.get("env") or {}).items():
        os.environ[k] = str(v)


def resolve_profile(args, cmd):
    data = load_profiles()
    profs = data.get("profiles") or {}
    name = args.profile or (None if cmd == "resume" or args.backend else os.environ.get("EASYRE_PROFILE") or data.get("default"))
    if not name:
        return None
    if name not in profs:
        sys.exit(f"unknown profile {name!r}; available: {', '.join(profs) or 'none'}")
    p = profs[name]
    if args.backend is None:
        args.backend = p.get("backend", "claude")
    if args.model is None:
        own = name == os.environ.get("EASYRE_PROFILE")
        args.model = (os.environ.get("EASYRE_MODEL") if own else None) or p.get("model")
    return name


def profiles(_):
    data = load_profiles()
    profs = data.get("profiles") or {}
    if not profs:
        print("no profiles; add them to config/backends.toml")
        return 0
    d = os.environ.get("EASYRE_PROFILE") or data.get("default")
    for n, p in profs.items():
        where = p.get("base_url", "")
        m = p.get("model") or ""
        if n == d and os.environ.get("EASYRE_MODEL"):
            m = f"{os.environ['EASYRE_MODEL']} (EASYRE_MODEL)"
        print(f"{'*' if n == d else ' '} {n:24} {p.get('backend', 'claude'):7} {m:32} {where}")
    print("\n* = default. Use: easyre run TASK --profile NAME")
    return 0


def setup_backend(cfg):
    b = cfg["backend"]
    if b == "claude" and not (os.environ.get("CLAUDE_CODE_OAUTH_TOKEN") or os.environ.get("ANTHROPIC_API_KEY")):
        sys.exit("claude backend: set CLAUDE_CODE_OAUTH_TOKEN in .env (easyre login claude)")
    if b == "claude":
        keep = STATE / "claude-projects"
        keep.mkdir(parents=True, exist_ok=True)
        proj = Path.home() / ".claude" / "projects"
        if not proj.is_symlink():
            if proj.is_dir():
                for x in proj.iterdir():
                    if not (keep / x.name).exists():
                        shutil.move(str(x), keep / x.name)
                shutil.rmtree(proj, ignore_errors=True)
            proj.parent.mkdir(parents=True, exist_ok=True)
            proj.symlink_to(keep, target_is_directory=True)
    if b == "codex":
        home = Path(os.environ.get("CODEX_HOME", STATE / "codex"))
        home.mkdir(parents=True, exist_ok=True)
        for f in ("config.toml", "hooks.json"):
            shutil.copy(CONF / f"codex-{f}", home / f)
        if not (home / "auth.json").exists() and not os.environ.get("OPENAI_API_KEY"):
            sys.exit("codex backend: run `easyre login codex` or set OPENAI_API_KEY in .env")
    if b == "openai" and not os.environ.get("OPENAI_BASE_URL") and not os.environ.get("OPENAI_API_KEY"):
        sys.exit("openai backend: set OPENAI_BASE_URL (and OPENAI_API_KEY) in .env")


def drive(job, cfg, interactive=False):
    link_work(job)
    apply_profile(cfg)
    PROG["hidden"] = cfg["mode"] in ("hint", "tutor")
    PROG["logs"] = (cfg.get("logs") or bool(os.environ.get("EASYRE_VERBOSE"))) and not PROG["hidden"]
    PROG["t0"] = time.time()
    PROG["n"] = 0
    setup_backend(cfg)
    ins = instructions(cfg)
    m = meta(job)
    m.mkdir(exist_ok=True)
    (job / "agent").mkdir(exist_ok=True)
    (m / "instructions.md").write_text(ins)
    if cfg["backend"] == "codex":
        (Path(os.environ.get("CODEX_HOME", STATE / "codex")) / "AGENTS.md").write_text(ins)
    (m / "stops").unlink(missing_ok=True)
    (m / "start").write_text(str(time.time()))
    prompt = agent_prompt(cfg, job)
    extra = []
    if interactive:
        if cfg["backend"] == "claude":
            c = ["claude", "--dangerously-skip-permissions", "--append-system-prompt", ins] + (["--model", cfg["model"]] if cfg.get("model") else [])
            c += ["--resume", cfg["session"]] if cfg.get("session") else [prompt]
        elif cfg["backend"] == "codex":
            c = ["codex", "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust"] + (["-m", cfg["model"]] if cfg.get("model") else [])
            c = (["codex", "resume", *c[1:], cfg["session"]] if cfg.get("session") else c + [prompt])
        else:
            sys.exit("-i works with claude and codex backends")
        os.chdir(WORK)
        subprocess.run(c)
        return report(job, cfg, "interactive session ended")
    t0 = time.time()
    log("agent started; first output can take a minute. Ctrl+C stops and keeps the job resumable.")
    try:
        why = loop(job, cfg, prompt, t0, extra)
    except KeyboardInterrupt:
        why = "stopped by user"
        log(f"stopped. Continue later with: easyre resume {job.name}")
    cfg["elapsed_s"] += int(time.time() - t0)
    jsave(meta(job) / "job.json", cfg)
    rc = report(job, cfg, why)
    if cfg["mode"] == "tutor" and (meta(job) / "answer").exists():
        return tutor_chat(job, cfg)
    return rc


TUTOR_HELP = """Tutor chat. Write what you did and what you see; ask anything.
  /hint     ask for a nudge
  /answer   reveal the answer
  /quit     leave (continue later with: easyre tutor JOB)"""


def redact(text, ans):
    return text.replace(ans, "[hidden]") if ans and len(ans) >= 3 else text


def tutor_turn_cli(cmd, inp, cfg, parse):
    try:
        p = subprocess.run(cmd, input=inp, cwd=WORK, capture_output=True, text=True, timeout=1800, errors="replace")
    except subprocess.TimeoutExpired:
        return "(the tutor took too long; try again)"
    text = ""
    with open(meta() / "log.jsonl", "a") as lg:
        for line in p.stdout.splitlines():
            lg.write(line + "\n")
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            parse(ev, cfg)
            if ev.get("type") == "result" and isinstance(ev.get("result"), str):
                text = ev["result"]
            it = ev.get("item") or {}
            if ev.get("type") == "item.completed" and it.get("type") == "agent_message":
                text = it.get("text", "")
    jsave(meta() / "job.json", cfg)
    return text.strip() or "(no reply)"


def tutor_turn(cfg, msg):
    b = cfg["backend"]
    if b == "claude":
        cmd = ["claude", "-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions",
               "--append-system-prompt", (meta() / "instructions.md").read_text()]
        if cfg.get("model"):
            cmd += ["--model", cfg["model"]]
        if cfg.get("session"):
            cmd += ["--resume", cfg["session"]]
        cfg["_base"] = cfg["tokens"]
        return tutor_turn_cli(cmd, msg, cfg, parse_claude)
    if b == "codex":
        base = ["--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust", "--json"]
        if cfg.get("model"):
            base += ["-m", cfg["model"]]
        cmd = ["codex", "exec", "resume", *base, cfg["session"], "-"] if cfg.get("session") else ["codex", "exec", *base, "-"]
        return tutor_turn_cli(cmd, msg, cfg, parse_codex)
    hist = meta() / "openai_history.json"
    msgs = jload(hist) or [{"role": "system", "content": (meta() / "instructions.md").read_text()}]
    msgs.append({"role": "user", "content": msg})
    for _ in range(25):
        resp = chat(msgs, cfg)
        u = resp.get("usage") or {}
        cfg["tokens"] += int(u.get("completion_tokens") or 0)
        m = resp["choices"][0]["message"]
        msgs.append({k: v for k, v in m.items() if k in ("role", "content", "tool_calls")})
        calls = m.get("tool_calls") or []
        if not calls:
            jsave(hist, msgs)
            jsave(meta() / "job.json", cfg)
            return str(m.get("content") or "").strip()
        for c in calls:
            try:
                a = json.loads(c["function"].get("arguments") or "{}")
            except ValueError:
                a = {}
            msgs.append({"role": "tool", "tool_call_id": c["id"], "content": tool_call(c["function"]["name"], a)})
    jsave(hist, msgs)
    return "(the tutor got stuck; try rephrasing)"


def tutor_chat(job, cfg):
    link_work(job)
    ans = (meta(job) / "answer").read_text().strip()
    log_md = job / "tutor.md"
    if not log_md.exists():
        log_md.write_text(f"# Tutor session: {cfg['name']}\n\n")
    print("\n" + TUTOR_HELP + "\n")
    first = not cfg.get("tutor_started")
    if first:
        cfg["tutor_started"] = True
        jsave(meta(job) / "job.json", cfg)
        msg = "[TUTOR PHASE START] Greet the student in 2-3 sentences: say what kind of target this is (no spoilers) and ask what they have tried so far."
        reply = redact(tutor_turn(cfg, msg), ans)
        print(f"\ntutor> {reply}\n")
        with open(log_md, "a") as o:
            o.write(f"**Tutor:** {reply}\n\n")
    while True:
        try:
            user = input(paint("you> ", "cyan", "bold")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not user:
            continue
        if user in ("/quit", "/exit", "/q"):
            break
        if user == "/answer":
            if input("Reveal the answer? [y/N] ").strip().lower() == "y":
                print(f"\nAnswer: {ans}\n")
                with open(log_md, "a") as o:
                    o.write(f"**Answer revealed:** `{ans}`\n\n")
            continue
        if user == "/help":
            print(TUTOR_HELP)
            continue
        msg = ("[STUDENT] The student asks for a nudge: give the next small step from where they are."
               if user == "/hint" else f"[STUDENT] {user}")
        print("(tutor is thinking...)")
        reply = redact(tutor_turn(cfg, msg), ans)
        print(f"\ntutor> {reply}\n")
        with open(log_md, "a") as o:
            o.write(f"**You:** {user}\n\n**Tutor:** {reply}\n\n")
    print(f"Conversation saved to {job.name}/tutor.md. Continue later with: easyre tutor {job.name}")
    return 0


def tutor(argv):
    if not argv:
        sys.exit("usage: easyre tutor JOB")
    job = find_job(argv[0])
    cfg = jload(meta(job) / "job.json")
    if cfg.get("mode") != "tutor":
        sys.exit(f"{job.name} was not started in tutor mode. Start one with: easyre run TASK --mode tutor")
    apply_profile(cfg)
    setup_backend(cfg)
    link_work(job)
    if not (meta(job) / "answer").exists():
        return drive(job, cfg)
    return tutor_chat(job, cfg)


def loop(job, cfg, prompt, t0, extra):
    why, resumes = "", int(os.environ.get("EASYRE_RESUMES", "12"))
    for n in range(resumes + 1):
        fail, why = BACKENDS[cfg["backend"]](cfg, prompt, t0, extra)
        jsave(meta(job) / "job.json", cfg)
        if finished(cfg) or why:
            break
        if fail == "auth":
            why = "backend authentication failed"
            break
        pause = 900 if fail == "limit" else 1 if fail == "lost-session" else 30 if fail else 5
        if cfg["backend"] != "openai" and not cfg.get("session") and fail != "lost-session":
            pause = max(pause, 30)
        log(f"agent stopped without finishing ({fail or 'no answer'}); retry {n + 1}/{resumes} in {pause}s")
        time.sleep(pause)
        if budget_left(cfg, t0):
            why = budget_left(cfg, t0)
            break
    return why


def report(job, cfg, why):
    m = meta(job)
    ans = (m / "ANSWER").read_text().strip() if (m / "ANSWER").exists() else ""
    status = "solved" if ans else f"not solved ({why or 'agent gave up'})"
    if cfg["mode"] == "hint":
        status = "hints ready" if (m / "DONE").exists() else status
    if cfg["mode"] == "tutor":
        status = "tutor ready" if (m / "answer").exists() else status
    head = [f"# {cfg['name']} - EasyRE report", "",
            f"- Status: **{status}**",
            f"- Backend: {cfg['backend']} {cfg.get('model') or ''}", f"- Mode: {cfg['mode']}",
            f"- Time: {cfg['elapsed_s'] // 60} min {cfg['elapsed_s'] % 60} s",
            f"- Tokens: {cfg['tokens']} out / {cfg.get('tokens_in', 0)} in (uncached)"]
    if cfg.get("cost_usd"):
        head.append(f"- API-equivalent cost: ${cfg['cost_usd']:.2f} (on a subscription you pay nothing extra)")
    if cfg["mode"] == "solve" and ans:
        head.append(f"- Answer: `{ans}` ({(m / 'CHECK').read_text().strip() if (m / 'CHECK').exists() else 'unchecked'})")
    if cfg["mode"] == "hint":
        head.append("- Answer hidden. Step through hints with `easyre hint " + job.name + "`; the answer is in `.answer`.")
    body = (job / "report.md").read_text() if (job / "report.md").exists() else ""
    if body.startswith("# " + cfg["name"] + " - EasyRE report"):
        body = body.split("\n---\n", 1)[-1]
    if cfg["mode"] == "tutor":
        body = f"Chat with the tutor: `easyre tutor {job.name}`. The conversation is saved in `tutor.md`. Agent notes (`agent/notes.md`, `.easyre/`) contain the solution: avoid them until you are done.\n"
    elif cfg["mode"] == "hint":
        body = "Hints are in `hints.md`. Agent notes (`notes.md`, `log.jsonl`) contain the solution: avoid them until you are done.\n"
    elif not body.strip() and (job / "agent" / "notes.md").exists():
        body = "## Agent notes\n\n" + (job / "agent" / "notes.md").read_text()
    (job / "report.md").write_text("\n".join(head) + "\n\n---\n" + body)
    log(f"{status} -> {job}/report.md")
    print(job / "report.md")
    return 0 if ans or (m / "DONE").exists() else 1


def verify(cfg, cand):
    fmt, cmd, ok = cfg.get("flag_format"), cfg.get("verify"), cfg.get("success")
    if fmt and not re.fullmatch(fmt, cand):
        return "bad-format", f"does not match {fmt}"
    if not cmd:
        return "unverified", "no verifier configured; accepted on your evidence"
    run = cmd.replace("{}", subprocess.list2cmdline([cand])) if "{}" in cmd else cmd
    try:
        r = subprocess.run(["bash", "-lc", run], cwd=WORK, input=None if "{}" in cmd else cand + "\n",
                           capture_output=True, text=True, timeout=120, errors="replace")
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired as e:
        out, r = (e.stdout or "") if isinstance(e.stdout, str) else "", None
    good = bool(re.search(ok, out)) if ok else (r is not None and r.returncode == 0)
    return ("correct" if good else "incorrect"), out.strip()[-800:]


def check(argv):
    if not argv:
        sys.exit("usage: easyre check '<answer>'")
    cand = argv[-1]
    cfg = jload(meta() / "job.json") or {}
    status, detail = verify(cfg, cand)
    with open(meta() / "attempts.log", "a") as o:
        o.write(f"{time.strftime('%H:%M:%S')} {status} {cand}\n")
    print(status)
    if detail:
        print(detail)
    if status in ("correct", "unverified"):
        if cfg.get("mode") == "tutor":
            (meta() / "answer").write_text(cand + "\n")
            print("-> Answer saved privately. Write your private notes to /work/agent/notes.md, then stop. Do not reveal the answer.")
        elif cfg.get("mode") == "hint":
            (meta() / "answer").write_text(cand + "\n")
            print("-> Answer saved privately. Now write /work/hints.md and run `easyre done`. Never print the answer in hints.md.")
        else:
            (meta() / "ANSWER").write_text(cand + "\n")
            (meta() / "CHECK").write_text(status + "\n")
            print("-> Write /work/report.md now, then stop.")
        return 0
    return 1


def done(_):
    h = WORK / "hints.md"
    if not (meta() / "answer").exists():
        print("no verified answer yet: run `easyre check '<answer>'` first")
        return 1
    if not h.exists() or len(re.findall(r"^## ", h.read_text(), re.M)) < 2:
        print("/work/hints.md needs at least 2 sections starting with '## '")
        return 1
    ans = (meta() / "answer").read_text().strip()
    if ans and ans in h.read_text():
        print("hints.md contains the answer; remove it")
        return 1
    (meta() / "DONE").write_text("1\n")
    print("done. Stop now.")
    return 0


def find_job(key):
    p = Path(key)
    if p.is_dir():
        return migrate(p.resolve())
    c = [d for d in sorted(JOBS.glob(f"{key}*")) if d.is_dir()]
    if not c:
        sys.exit(f"no job {key!r}; see `easyre jobs`")
    return migrate(c[-1])


def hint(argv):
    job = find_job(argv[0])
    h = job / "hints.md"
    if not h.exists():
        sys.exit("no hints.md in this job")
    parts = re.split(r"(?m)^(?=## )", h.read_text())
    intro, secs = (parts[0], parts[1:]) if not parts[0].startswith("## ") else ("", parts)
    hi = meta(job) / "hint_idx"
    idx = int(hi.read_text()) if hi.exists() else 0
    if "--reset" in argv:
        idx = 0
    if idx == 0 and intro.strip():
        print(intro.strip() + "\n")
    if idx >= len(secs):
        print("No more hints.")
        if "--answer" in argv:
            a = meta(job) / "answer"
            print("Answer:", (a if a.exists() else job / ".answer").read_text().strip())
        else:
            print("To reveal the answer: easyre hint", job.name, "--answer")
        return 0
    print(secs[idx].strip())
    print(f"\n[hint {idx + 1}/{len(secs)}] next: easyre hint {job.name}")
    hi.write_text(str(idx + 1))
    return 0


def job_status(d):
    m = meta(d)
    if (m / "ANSWER").exists():
        return "solved"
    if (m / "DONE").exists():
        return "hints"
    if (m / "answer").exists() and (jload(m / "job.json") or {}).get("mode") == "tutor":
        return "tutor"
    return "closed" if (m / "CLOSED").exists() else "open"


def all_jobs():
    return sorted({migrate(p.parent.parent if p.parent.name == ".easyre" else p.parent)
                   for p in list(JOBS.glob("*/job.json")) + list(JOBS.glob("*/.easyre/job.json"))})


def jobs(_):
    js = all_jobs()
    if not js:
        print("no jobs yet. Start one: easyre run <task>")
        return 0
    print(f"{'JOB':45} {'STATUS':7} {'BACKEND':7} {'MODE':5} {'TIME':>6} {'TOKENS':>13}")
    for d in js:
        c = jload(meta(d) / "job.json") or {}
        st = job_status(d)
        stc = {"solved": "green", "hints": "green", "tutor": "green", "open": "yellow", "closed": "blue"}.get(st)
        e = int(c.get("elapsed_s", 0))
        print(f"{d.name:45} {paint(f'{st:7}', stc) if stc else f'{st:7}'} {c.get('backend', ''):7} {c.get('mode', ''):5} {e // 60:>3}:{e % 60:02d} {c.get('tokens', 0):>9} tok")
    return 0


def close(argv):
    if not argv:
        sys.exit("usage: easyre close JOB")
    job = find_job(argv[0])
    (meta(job) / "CLOSED").write_text(time.strftime("%F %T") + "\n")
    print(f"closed {job.name} (easyre resume reopens it)")
    return 0


def remove(argv):
    names = [a for a in argv if not a.startswith("-")]
    groups = {"--open": {"open"}, "--closed": {"closed"}, "--unsolved": {"open", "closed"},
              "--solved": {"solved", "hints"}, "--all": {"open", "closed", "solved", "hints"}}
    wanted = set().union(*[groups[a] for a in argv if a in groups])
    unknown = [a for a in argv if a.startswith("-") and a not in groups and a != "-y"]
    if unknown or not (wanted or names):
        sys.exit("usage: easyre rm JOB [JOB...] | easyre rm --open|--closed|--unsolved|--solved|--all [-y]")
    targets = [find_job(n) for n in names]
    targets += [d for d in all_jobs() if job_status(d) in wanted and d not in targets]
    if not targets:
        print("nothing to remove")
        return 0
    for t in targets:
        print(" ", t.name)
    if "-y" not in argv:
        if input(f"Delete {len(targets)} job folder(s) permanently? [y/N] ").strip().lower() != "y":
            print("cancelled")
            return 1
    for t in targets:
        if WORK.is_symlink() and WORK.resolve() == t.resolve():
            WORK.unlink()
        shutil.rmtree(t)
    print(f"deleted {len(targets)}")
    return 0


def doctor(argv):
    ok = True

    def line(good, what, hint=""):
        nonlocal ok
        ok = ok and good
        mark = paint("OK ", "green", "bold") if good else paint("ERR", "red", "bold")
        print(f"  {mark}  {what}" + (paint(f"\n       -> {hint}", "yellow") if hint and not good else ""))

    print("EasyRE doctor\n")
    data = load_profiles()
    profs = data.get("profiles") or {}
    name = os.environ.get("EASYRE_PROFILE") or data.get("default")
    p = profs.get(name) if name else None
    line(p is not None, f"profile: {name or '-'}", "set EASYRE_PROFILE in .env to one of: " + ", ".join(profs))
    if p is None:
        return 1
    backend = p.get("backend", "claude")
    model = os.environ.get("EASYRE_MODEL") or p.get("model") or "(backend default)"
    print(f"       backend={backend} model={model}")
    cfg = {"profile": name}
    try:
        apply_profile(cfg)
    except SystemExit as e:
        line(False, "profile credentials", str(e))
        return 1
    if backend == "claude":
        has = bool(os.environ.get("CLAUDE_CODE_OAUTH_TOKEN") or os.environ.get("ANTHROPIC_API_KEY"))
        line(has, "Claude credentials", "run setup again, or `easyre login claude` and paste the token into .env")
        line(bool(shutil.which("claude")), "Claude Code installed", "rebuild the image: docker compose build")
    elif backend == "codex":
        auth = (STATE / "codex" / "auth.json").exists() or bool(os.environ.get("OPENAI_API_KEY"))
        line(auth, "Codex login", "run `easyre login codex`")
        line(bool(shutil.which("codex")), "Codex CLI installed", "rebuild the image: docker compose build")
    else:
        base = os.environ.get("OPENAI_BASE_URL", "").rstrip("/")
        line(bool(base), f"API endpoint: {base or '-'}", "set base_url in the profile")
        if base:
            try:
                req = urllib.request.Request(base + "/models", headers={"Authorization": f"Bearer {os.environ.get('OPENAI_API_KEY', 'none')}"})
                with urllib.request.urlopen(req, timeout=10) as resp:
                    ids = [m.get("id") for m in (json.loads(resp.read()).get("data") or [])]
                line(True, "API reachable")
                if ids and p.get("model") and model not in ids:
                    line(False, f"model {model} available", "available: " + ", ".join(ids[:15]))
            except Exception as e:
                hint = "is the server running? For Ollama/LM Studio on this PC use host.docker.internal" if "localhost" not in base else "use host.docker.internal instead of localhost"
                line(False, f"API reachable ({e.__class__.__name__}: {str(e)[:80]})", hint)
    line(bool(shutil.which("wine")), "Wine (runs .exe targets)", "check toolchain/install.sh and rebuild")
    # Toolchain report. These tools are optional (enabled via the EASYRE_TOOLS
    # build-arg), so they never fail doctor; the agent installs what it needs.
    import importlib.util
    def have(mod):
        try:
            return importlib.util.find_spec(mod) is not None
        except Exception:
            return False
    CHK, DOT = "+", "-"
    groups = [
        ("core", ["objdump", "gdb", "radare2", "strings", "upx", "binwalk", "yara", "floss", "capa"]),
        ("die", ["diec"]),
        ("ghidra", ["analyzeHeadless", "pyghidraRun"]),
        ("dotnet", ["dotnet", "ilspycmd", "il2cppdumper", "de4dot"]),
        ("jvm", ["jadx", "apktool", "cfr"]),
        ("python", ["pyinstxtractor-ng", "pycdc", "decompyle3"]),
        ("js", ["asar", "webcrack", "js-beautify"]),
    ]
    print("  ---  toolchain (+ installed, - missing; optional, set EASYRE_TOOLS in .env and rebuild):")
    for gname, tools in groups:
        marks = " ".join((CHK if shutil.which(t) else DOT) + t for t in tools)
        print(f"       {gname:<7} {marks}")
    pys = [("z3", "z3"), ("angr", "angr"), ("capstone", "capstone"), ("unicorn", "unicorn"), ("lief", "lief"), ("pefile", "pefile")]
    print("       py      " + " ".join((CHK if have(mod) else DOT) + k for k, mod in pys))
    pf = CHK if (PREFETCH.exists() and os.access(PREFETCH, os.X_OK)) else DOT + " (install the ghidra module)"
    print(f"       prefetch hook: {pf}")
    names = skill_names()
    todo = [n for n in names if "TODO" in (SKILLS / n / "SKILL.md").read_text()]
    print(f"  ---  skills: {len(names)} installed, {len(names) - len(todo)} filled in, {len(todo)} still TODO")
    tasks = [t.name for t in TASKS.iterdir() if not t.name.startswith(".")] if TASKS.is_dir() else []
    print(f"  ---  tasks folder: {len(tasks)} item(s)" + (f": {', '.join(tasks[:8])}" if tasks else " (put a crackme into ./tasks)"))
    print("\nAll good. Try: easyre run <task> --success \"<success text>\"" if ok else "\nFix the ERR lines above.")
    return 0 if ok else 1


def job_cost(cfg):
    if cfg.get("cost_usd"):
        return float(cfg["cost_usd"])
    p = ((load_profiles().get("profiles") or {}).get(cfg.get("profile") or "") or {})
    if "price_in" in p or "price_out" in p:
        return (cfg.get("tokens_in", 0) * float(p.get("price_in", 0)) + cfg.get("tokens", 0) * float(p.get("price_out", 0))) / 1e6
    return None


def fmt_time(sec):
    sec = int(sec)
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m" if sec >= 3600 else f"{sec // 60}:{sec % 60:02d}"


def fmt_cost(c):
    if c is None:
        return "-"
    return f"${c:.2f}" if c >= 1 or c == 0 else f"${c:.4f}"


def stats(_):
    rows = {}
    for d in all_jobs():
        c = jload(meta(d) / "job.json") or {}
        key = c.get("profile") or f"{c.get('backend', '?')}:{c.get('model') or '-'}"
        r = rows.setdefault(key, {"jobs": 0, "done": 0, "time": 0, "out": 0, "in": 0, "cost": 0.0, "known": True})
        r["jobs"] += 1
        r["done"] += job_status(d) in ("solved", "hints", "tutor")
        r["time"] += int(c.get("elapsed_s", 0))
        r["out"] += int(c.get("tokens", 0))
        r["in"] += int(c.get("tokens_in", 0))
        cost = job_cost(c)
        if cost is None:
            r["known"] = False
        else:
            r["cost"] += cost
    if not rows:
        print("no jobs yet")
        return 0
    print(f"{'PROFILE':26} {'JOBS':>4} {'DONE':>4} {'TIME':>7} {'TOKENS OUT':>11} {'TOKENS IN':>11} {'COST':>9}")
    tot = {"jobs": 0, "done": 0, "time": 0, "out": 0, "in": 0, "cost": 0.0}
    for k, r in sorted(rows.items()):
        cost = fmt_cost(r["cost"]) + ("" if r["known"] else "*")
        print(f"{k:26} {r['jobs']:>4} {r['done']:>4} {fmt_time(r['time']):>7} {r['out']:>11,} {r['in']:>11,} {cost:>9}")
        for x in tot:
            tot[x] += r[x]
    print(f"{'TOTAL':26} {tot['jobs']:>4} {tot['done']:>4} {fmt_time(tot['time']):>7} {tot['out']:>11,} {tot['in']:>11,} {fmt_cost(tot['cost']):>9}")
    print("\nCOST for Claude is the API-equivalent price (a subscription costs nothing extra).")
    print("* = cost unknown for some jobs: add price_in / price_out (USD per 1M tokens) to the profile in config/backends.toml.")
    return 0


def login(argv):
    what = argv[0] if argv else ""
    if what == "claude":
        print("Log in with your Claude subscription. Copy the sk-ant-oat... token into .env as CLAUDE_CODE_OAUTH_TOKEN=...")
        return subprocess.run(["claude", "setup-token"]).returncode
    if what == "codex":
        home = STATE / "codex"
        home.mkdir(parents=True, exist_ok=True)
        return subprocess.run(["codex", "login", "--device-auth"], env={**os.environ, "CODEX_HOME": str(home)}).returncode
    sys.exit("usage: easyre login claude|codex")


def opts(p):
    p.add_argument("--desc")
    p.add_argument("--desc-file")
    p.add_argument("--success")
    p.add_argument("--flag-format")
    p.add_argument("--verify")
    p.add_argument("--profile")
    p.add_argument("--backend", choices=list(BACKENDS))
    p.add_argument("--model")
    p.add_argument("--mode", choices=["solve", "hint", "tutor"])
    p.add_argument("--budget-min", type=float)
    p.add_argument("--budget-tokens", type=int)
    p.add_argument("--name")
    p.add_argument("-i", action="store_true")
    p.add_argument("--force", action="store_true")
    p.add_argument("--logs", action="store_true")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = a[0], a[1:]
    simple = {"check": check, "done": done, "hint": hint, "jobs": jobs, "login": login, "profiles": profiles, "close": close, "rm": remove, "doctor": doctor, "tutor": tutor, "stats": stats}
    if cmd in simple:
        return simple[cmd](rest)
    if cmd not in ("run", "resume"):
        print(__doc__)
        return 2
    p = argparse.ArgumentParser(prog=f"easyre {cmd}")
    p.add_argument("target" if cmd == "run" else "job")
    opts(p)
    args = p.parse_args(rest)
    prof = resolve_profile(args, cmd)
    if cmd == "run":
        for k, v in {"backend": os.environ.get("EASYRE_BACKEND", "claude"), "mode": "solve",
                     "budget_min": float(os.environ.get("EASYRE_BUDGET_MIN", "120"))}.items():
            if getattr(args, k) is None:
                setattr(args, k, v)
        if args.model is None:
            args.model = os.environ.get("EASYRE_MODEL") or ({"claude": "opus"}.get(args.backend))
        job, cfg = prepare(args)
        cfg["profile"] = prof
        cfg["logs"] = args.logs
        jsave(meta(job) / "job.json", cfg)
    else:
        job = find_job(args.job)
        if job_status(job) in ("solved", "hints") and "--force" not in rest:
            print(f"{job.name} is already {job_status(job)}. See {job.name}/report.md, or add --force to run the agent again.")
            return 0
        for f in ("CLOSED",) + (("ANSWER", "CHECK", "DONE") if args.force else ()):
            (meta(job) / f).unlink(missing_ok=True)
        cfg = jload(meta(job) / "job.json")
        for k in ("desc", "success", "flag_format", "verify", "backend", "model", "mode", "budget_min", "budget_tokens"):
            if getattr(args, k, None) is not None:
                cfg[k] = getattr(args, k)
        if prof:
            cfg["profile"] = prof
        elif args.backend:
            cfg["profile"] = None
        if args.backend and args.backend != jload(meta(job) / "job.json").get("backend"):
            cfg["session"] = None
        jsave(meta(job) / "job.json", cfg)
    if getattr(args, "logs", False):
        cfg["logs"] = True
    log(f"job {job.name}: profile={cfg.get('profile') or '-'} backend={cfg['backend']} model={cfg.get('model')} mode={cfg['mode']} budget={cfg['budget_min']} min")
    return drive(job, cfg, args.i)


def run_main():
    try:
        return main() or 0
    except KeyboardInterrupt:
        print(paint("\nstopped.", "yellow"), file=sys.stderr)
        return 130
    except SystemExit as e:
        if isinstance(e.code, str):
            print(paint("error: ", "red", "bold") + e.code, file=sys.stderr)
            return 1
        return e.code or 0
    except Exception as e:
        import traceback
        JOBS.mkdir(parents=True, exist_ok=True)
        f = JOBS / "_errors.log"
        with open(f, "a") as o:
            o.write(f"\n=== {time.strftime('%F %T')} easyre {' '.join(sys.argv[1:])}\n{traceback.format_exc()}")
        print(paint("error: ", "red", "bold") + f"{e.__class__.__name__}: {e}", file=sys.stderr)
        print(paint("Something went wrong inside easyre. Full details are in jobs/_errors.log; paste them in an issue or chat.", "yellow"), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(run_main())
