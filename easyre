COLOR = not os.environ.get("NO_COLOR") and (sys.stderr.isatty() or bool(os.environ.get("FORCE_COLOR")))
CODES = {"red": "31", "green": "32", "yellow": "33", "blue": "34", "magenta": "35", "cyan": "36", "dim": "2", "bold": "1"}


def paint(text, *styles):
    if not COLOR or not styles:
        return str(text)
    return "\033[" + ";".join(CODES[x] for x in styles) + "m" + str(text) + "\033[0m"


def log(*a, color=None):
    if PROG.get("last") is not None and not PROG["logs"] and (sys.stderr.isatty() or os.environ.get("FORCE_COLOR")) and PROG["n"]:
        sys.stderr.write("\r\033[K"); sys.stderr.flush()
    msg = " ".join(str(x) for x in a)
    if color is None:
        low = msg.lower()
        if low.startswith(("run failed", "api error", "error")) or "failed" in low[:40]:
            color = "red"
        elif low.startswith(("solved", "hints ready", "tutor ready")):
            color = "green"
        elif low.startswith(("budget", "stopped", "agent stopped", "transient", "previous agent session")):
            color = "yellow"
        elif low.startswith(("agent:",)):
            color = "bold"
        elif re.match(r"^(\$|bash:|read:|write:|edit:|grep:|glob:|task:|agent\S*:|read_file:|write_file:|read_skill:)", low):
            color = "blue"
    print(paint("[easyre]", "cyan"), paint(msg, color) if color else msg, file=sys.stderr, flush=True)


PROG = {"logs": False, "hidden": False, "n": 0, "t0": time.time(), "last": ""}


SPINNER = "|/-\\"


def progress_tick(note=""):
    PROG["n"] += 1
    if not sys.stderr.isatty() and not os.environ.get("FORCE_COLOR"):
        if PROG["n"] % 10 == 1:
            e = int(time.time() - PROG["t0"])
            log(f"working... {PROG['n']} steps, {e // 60}:{e % 60:02d}", color="cyan")
        return
    e = int(time.time() - PROG["t0"])
    spin = SPINNER[PROG["n"] % len(SPINNER)]
    note = PROG["last"] if not note else note
    PROG["last"] = note
    line = paint(f" {spin} working  {PROG['n']} steps  {e // 60}:{e % 60:02d}", "cyan") + (paint(f"   {note}", "dim") if note else "")
    sys.stderr.write("\r\033[K" + line)
    sys.stderr.flush()


def progress_end():
    if (sys.stderr.isatty() or os.environ.get("FORCE_COLOR")) and PROG["n"]:
        sys.stderr.write("\r\033[K")
        sys.stderr.flush()


def activity(label, text):
    if not PROG["logs"]:
        note = ""
        if not PROG["hidden"]:
            if label == "agent:":
                note = "thinking: " + str(text).strip().replace("\n", " ")[:60]
            else:
                first = re.sub(r"^cd /work\s*(;|&&)\s*", "", str(text).strip().splitlines()[0] if str(text).strip() else "")
                note = (label.rstrip(":") or "run") + ": " + first[:60]
        progress_tick(note)
        return
    if label == "agent:":
        log(paint("agent:", "bold") + " " + text.strip().replace("\n", " ")[:300], color="")
        return
    text = str(text).strip()
    body = [l for l in text.splitlines() if l.strip()]
    first = body[0] if body else ""
    first = re.sub(r"^cd /work\s*(;|&&)\s*", "", first)
    if len(first) > 110:
        first = first[:107] + "..."
    extra = f"  (+{len(body) - 1} more lines)" if len(body) > 1 else ""
    tool = label.rstrip(":") or "output"
    log(f"  {tool:<6} {first}{extra}", color="blue")


def meta(job=None):
    return Path(job or WORK) / ".easyre"


def migrate(job):
    job = Path(job)
    if not (job / "job.json").exists() or (job / ".easyre" / "job.json").exists():
        return job
    m = job / ".easyre"
    m.mkdir(exist_ok=True)
    (job / "agent").mkdir(exist_ok=True)
    moves = {"job.json": "job.json", "log.jsonl": "log.jsonl", "attempts.log": "attempts.log", "ANSWER": "ANSWER",
             "CHECK": "CHECK", "DONE": "DONE", "CLOSED": "CLOSED", ".answer": "answer", ".hint_idx": "hint_idx",
             ".openai_history.json": "openai_history.json", "triage.md": "triage.md", "instructions.md": "instructions.md",
             ".start": "start", "start": "start", ".stops": "stops"}
    for old, new in moves.items():
        if (job / old).exists() and not (m / new).exists():
            (job / old).rename(m / new)
    for old in ("AGENTS.md", "CLAUDE.md", ".start", "start"):
        (job / old).unlink(missing_ok=True)
    for old in ("notes.md", "tmp", "prefetch", "lanes"):
        if (job / old).exists() and not (job / "agent" / old).exists():
            (job / old).rename(job / "agent" / old)
    return job


def jload(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return default


def jsave(p, obj):
    Path(p).write_text(json.dumps(obj, indent=1))


def extract(f, dst):
    dst.mkdir(parents=True, exist_ok=True)
    if f.suffix.lower() in ARCHIVES:
        for pw in ["", "infected", "flare", "crackmes.one", "crackmes.de"]:
            r = subprocess.run(["7z", "x", "-y", f"-p{pw}", f"-o{dst}", str(f)], capture_output=True)
            if r.returncode in (0, 1):
                return True
        log(f"could not extract {f.name}; copying as-is")
    shutil.copy2(f, dst / f.name)
    return False


