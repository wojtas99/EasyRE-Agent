def skill_names():
    return sorted(d.name for d in SKILLS.iterdir() if (d / "SKILL.md").exists()) if SKILLS.is_dir() else []


def triage(src):
    lines, native = [], []
    files = sorted(p for p in src.rglob("*") if p.is_file())
    for f in files[:200]:
        ft = subprocess.run(["file", "-b", str(f)], capture_output=True, text=True).stdout.strip()
        try:
            data = f.read_bytes()[: 96 << 20]
        except OSError:
            data = b""
        tags = sorted({f"{label} [{kind}]" for sig, kind, label in MARKERS if sig in data})
        if len(data) > 0x40 and data[:2] != b"MZ":
            e = struct.unpack("<I", data[0x3C:0x40])[0]
            if data[e:e + 4] == b"PE\0\0":
                fx = src.parent / "agent" / (f.stem + ".fixed.exe")
                fx.parent.mkdir(exist_ok=True)
                fx.write_bytes(b"MZ" + data[2:])
                tags.append(f"broken MZ header, repaired copy: agent/{fx.name}")
        if shutil.which("diec") and re.search(r"PE32|ELF|Mach-O|MS-DOS", ft):
            try:
                die = subprocess.run(["diec", str(f)], capture_output=True, text=True, timeout=60).stdout.strip()
                tags += [f"DIE: {l.strip()}" for l in die.splitlines()[1:8] if l.strip()]
            except (subprocess.TimeoutExpired, OSError):
                pass
        lines.append(f"- {f.relative_to(src)} ({f.stat().st_size} B): {ft}" + "".join(f"\n  - {t}" for t in tags))
        if re.search(r"PE32|ELF", ft) and "Mono/.Net" not in ft and not any("python" in t or "dotnet" in t for t in tags) \
                and ".fixed." not in f.name:
            native.append(f)
    if len(files) > 200:
        lines.append(f"- ... {len(files) - 200} more files")
    if native and PREFETCH.exists() and os.access(PREFETCH, os.X_OK):
        f = max(native, key=lambda p: (p.suffix.lower() != ".dll", p.stat().st_size))
        out = WORK / "agent" / "prefetch"
        out.mkdir(parents=True, exist_ok=True)
        subprocess.Popen([str(PREFETCH), str(f), str(out)], stdout=open(out / "prefetch.log", "w"),
                         stderr=subprocess.STDOUT, start_new_session=True)
        lines.append(f"\nBackground Ghidra analysis of `{f.name}` started -> /work/agent/prefetch/ "
                     "(functions.txt, strings.txt, imports.txt, decompiled.c; DONE appears when finished; log prefetch.log)")
    return "\n".join(lines)


def auto_verify(src, success):
    if not success:
        return ""
    exes = [p for p in src.rglob("*") if p.is_file() and ".fixed." not in p.name]
    pes = [p for p in exes if p.suffix.lower() == ".exe"]
    if len(pes) == 1 and shutil.which("wine"):
        return f"wine /work/src/{pes[0].relative_to(src)}"
    elfs = [p for p in exes if p.read_bytes()[:4] == b"\x7fELF"]
    if len(elfs) == 1:
        os.chmod(elfs[0], 0o755)
        return f"/work/src/{elfs[0].relative_to(src)}"
    return ""


def link_work(job):
    if WORK.is_symlink():
        WORK.unlink()
    elif WORK.exists():
        shutil.rmtree(WORK)
    WORK.symlink_to(Path(job).resolve(), target_is_directory=True)


def instructions(cfg):
    mode = cfg["mode"]
    t = (CONF / "AGENT.md").read_text()
    t += "\n" + (CONF / {"hint": "MODE_HINT.md", "tutor": "MODE_TUTOR.md"}.get(mode, "MODE_SOLVE.md")).read_text()
    names = skill_names()
    t += "\n## Skills available\n" + ("\n".join(f"- `{n}`: {SKILLS / n / 'SKILL.md'}" for n in names) if names else "- none installed") + "\n"
    tools = CONF / "TOOLS.md"
    if tools.exists():
        t += "\n" + tools.read_text()
    v = ["\n## Verification set up for this job"]
    v.append(f"- Answer format: `{cfg['flag_format']}`" if cfg.get("flag_format") else "- Answer format: not given.")
    if cfg.get("verify"):
        v.append(f"- `easyre check` runs: `{cfg['verify']}` and looks for `{cfg.get('success') or '(exit code 0)'}` in the output.")
    elif cfg.get("success"):
        v.append(f"- Success output: `{cfg['success']}`. No run command was set, so run the target yourself and show the success output in the report.")
    else:
        v.append("- No automatic check. Prove the answer yourself (run the target, or reimplement the check and show it passes) before `easyre check`.")
    return t + "\n".join(v) + "\n"


def host_path(p):
    p = str(p)
    if Path(p).exists():
        return Path(p)
    norm = p.replace("\\", "/")
    low = norm.lower()
    for key, base in (("/tasks/", TASKS), ("/jobs/", JOBS)):
        i = low.rfind(key)
        if i >= 0:
            return base / norm[i + len(key):]
    if low.startswith("tasks/"):
        return TASKS / norm[6:]
    return TASKS / norm


def prepare(args):
    target = host_path(args.target)
    if not target.exists():
        sys.exit(f"target not found: {args.target} (put tasks under ./tasks on the host)")
    name = args.name or re.sub(r"[^A-Za-z0-9_.-]+", "_", target.stem if target.is_file() else target.name)
    job = JOBS / f"{name}-{time.strftime('%Y%m%d-%H%M%S')}"
    src = job / "src"
    src.mkdir(parents=True)
    (job / ".easyre").mkdir()
    (job / "agent").mkdir()
    desc = args.desc or ""
    if args.desc_file:
        f = host_path(args.desc_file)
        if not f.is_file():
            sys.exit(f"description file not found: {args.desc_file} (put it into the tasks folder, e.g. tasks\\{target.name}\\README.md)")
        desc = f.read_text(errors="replace")
    if target.is_dir():
        for f in sorted(target.iterdir()):
            if f.is_file() and f.name.lower() in ("task.md", "task.txt", "opis.txt", "opis.md", "readme.md", "readme.txt") and not desc:
                desc = f.read_text(errors="replace")
                continue
            if f.is_dir():
                shutil.copytree(f, src / f.name)
            else:
                extract(f, src)
    else:
        extract(target, src)
    cfg = {"name": name, "target": str(target), "desc": desc.strip(), "success": args.success, "flag_format": args.flag_format,
           "verify": args.verify, "backend": args.backend, "model": args.model, "mode": args.mode,
           "budget_min": args.budget_min, "budget_tokens": args.budget_tokens, "created": time.strftime("%F %T"),
           "elapsed_s": 0, "tokens": 0, "session": None}
    link_work(job)
    tri = triage(src)
    (meta(job) / "triage.md").write_text(tri + "\n")
    if not cfg["verify"]:
        cfg["verify"] = auto_verify(src, cfg["success"])
        if cfg["verify"]:
            log(f"auto verifier: {cfg['verify']}")
    (job / "TASK.md").write_text(f"# {name}\n\n{cfg['desc'] or '(no description given)'}\n")
    jsave(meta(job) / "job.json", cfg)
    return job, cfg


def agent_prompt(cfg, job):
    tri = (meta(job) / "triage.md").read_text()
    goal = {"solve": "Solve it, verify the answer with `easyre check '<answer>'`, then write /work/report.md.",
            "hint": "Solve it privately, verify with `easyre check '<answer>'`, write the graded hints to /work/hints.md, then run `easyre done`.",
            "tutor": "Phase 1: solve it privately, verify with `easyre check '<answer>'`, write your private notes, then stop. The student conversation starts after that."}[cfg["mode"]]
    return (f"# Task\n{cfg['desc'] or '(no description given)'}\n\n# Files\nThe handout is in /work/src.\n\n"
            f"# Triage\n{tri}\n\n{goal}")


def finished(cfg):
    if cfg["mode"] == "tutor":
        return (meta() / "answer").exists()
    if cfg["mode"] == "hint":
        return (meta() / "DONE").exists()
    return (meta() / "ANSWER").exists()


def budget_left(cfg, t0):
    spent = cfg["elapsed_s"] + (time.time() - t0)
    if spent > cfg["budget_min"] * 60:
        return "time"
    if cfg.get("budget_tokens") and cfg["tokens"] >= cfg["budget_tokens"]:
        return "tokens"
    return ""


def kill(p):
    try:
        os.killpg(p.pid, signal.SIGTERM)
        time.sleep(3)
        os.killpg(p.pid, signal.SIGKILL)
    except OSError:
        pass


def classify(msg):
    if re.search(r"oauth|invalid api key|/login|unauthori|authenticat|log ?in again|refresh.token", msg, re.I):
        return "auth"
    if re.search(r"usage limit|limit reached|rate.?limit|resets? at|try again at|overloaded|429", msg, re.I):
        return "limit"
    return "error"


def run_cli(cmd, inp, cfg, t0, parse):
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                         cwd=WORK, start_new_session=True)
    p.stdin.write(inp)
    p.stdin.close()
    stop = {"why": ""}

    def watch():
        while p.poll() is None:
            why = budget_left(cfg, t0)
            if why or finished(cfg):
                if why:
                    stop["why"] = why
                    log(f"budget reached ({why}), stopping agent")
                else:
                    end = time.time() + 180
                    while p.poll() is None and time.time() < end:
                        time.sleep(2)
                    if p.poll() is not None:
                        return
                kill(p)
                return
            time.sleep(2)

    threading.Thread(target=watch, daemon=True).start()
    fail = ""
    try:
        fail = read_events(p, cfg, parse)
    except KeyboardInterrupt:
        kill(p)
        raise
    p.wait()
    return fail, stop["why"]


def read_events(p, cfg, parse):
    fail = ""
    with open(meta() / "log.jsonl", "a") as lg:
        for line in p.stdout:
            lg.write(line)
            lg.flush()
            try:
                ev = json.loads(line)
            except ValueError:
                if line.strip():
                    activity("", line.rstrip()[:300])
                continue
            r = parse(ev, cfg)
            if r:
                fail = r
            jsave(meta() / "job.json", cfg)
    return fail


def parse_claude(ev, cfg):
    t = ev.get("type", "")
    if t == "system" and ev.get("subtype") == "init" and not cfg.get("session"):
        cfg["session"] = ev.get("session_id")
    if t == "assistant":
        m = ev.get("message") or {}
        u = m.get("usage") or {}
        cfg["tokens"] += int(u.get("output_tokens") or 0)
        for c in m.get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                activity("agent:", c["text"].strip()[:400])
            elif c.get("type") == "tool_use":
                i = c.get("input") or {}
                activity(f"{c.get('name')}:", str(i.get("command") or i.get("description") or i.get("file_path") or "")[:200])
    if t == "result":
        u = ev.get("usage") or {}
        cfg["tokens"] = cfg.get("_base", 0) + int(u.get("output_tokens") or 0)
        cfg["cost_usd"] = round(cfg.get("cost_usd", 0) + float(ev.get("total_cost_usd") or 0), 4)
        cfg["tokens_in"] = cfg.get("tokens_in", 0) + int(u.get("input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0)
        if ev.get("is_error") or ev.get("subtype", "success") != "success":
            msg = json.dumps(ev)[:600]
            if ev.get("num_turns") == 0 and cfg.get("session") and not ev.get("total_cost_usd"):
                cfg["session"] = None
                log("previous agent session is gone; starting a fresh session (notes and files in /work are kept)")
                return "lost-session"
            log("run failed:", msg)
            return classify(msg)
    return ""


def parse_codex(ev, cfg):
    t, it = ev.get("type", ""), ev.get("item") or {}
    if t == "thread.started" and not cfg.get("session"):
        cfg["session"] = ev.get("thread_id")
    if t == "turn.completed":
        u = ev.get("usage") or {}
        cfg["tokens"] += int(u.get("output_tokens") or 0)
        cfg["tokens_in"] = cfg.get("tokens_in", 0) + int(u.get("input_tokens") or 0) - int(u.get("cached_input_tokens") or 0)
    if t == "item.completed" and it.get("type") == "agent_message":
        activity("agent:", it.get("text", "")[:400])
    if t == "item.started" and it.get("type") == "command_execution":
        activity("$", it.get("command", "")[:200])
    if t in ("turn.failed", "error"):
        msg = json.dumps(ev)[:600]
        log("run failed:", msg)
        return classify(msg)
    return ""


CONTINUE = "You stopped before finishing. Re-read /work/agent/notes.md, pick the most promising unexplored lead, and keep going."


def backend_claude(cfg, prompt, t0, extra):
    base = ["-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions",
            "--append-system-prompt", (meta() / "instructions.md").read_text()]
    if cfg.get("model"):
        base += ["--model", cfg["model"]]
    base += extra
    cfg["_base"] = cfg["tokens"]
    if cfg.get("session"):
        return run_cli(["claude", "--resume", cfg["session"], *base], CONTINUE, cfg, t0, parse_claude)
    return run_cli(["claude", *base], prompt, cfg, t0, parse_claude)


def backend_codex(cfg, prompt, t0, extra):
    base = ["--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust", "--json"]
    if cfg.get("model"):
        base += ["-m", cfg["model"]]
    base += extra
    if cfg.get("session"):
        return run_cli(["codex", "exec", "resume", *base, cfg["session"], "-"], CONTINUE, cfg, t0, parse_codex)
    return run_cli(["codex", "exec", *base, "-"], prompt, cfg, t0, parse_codex)


