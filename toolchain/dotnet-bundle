#!/usr/bin/env python3
"""dotnet-bundle - extract files from a .NET single-file bundle.

  dotnet-bundle <host.exe> -o OUTDIR [--all]

A .NET single-file app (apphost / singlefilehost) appends its managed
assemblies, deps.json, runtimeconfig.json and the framework as a bundle in the
PE overlay. `ilspycmd` cannot read the host .exe directly - extract the bundle
first, then decompile the DLLs from OUTDIR.

By default only the app's own files are written (names containing the exe stem);
--all writes every embedded file. Stored entries are copied; compressed entries
(bundle v6+) are inflated (raw deflate), and if that fails the raw bytes are
written with a .deflate suffix and a warning.

Stdlib only. Parses the public dotnet/runtime bundle layout generically across
bundle versions - no per-target assumptions.
"""
import argparse, os, re, struct, sys, zlib

# 32-byte signature embedded in every single-file host; the 8 bytes before it
# hold the int64 offset of the bundle manifest header.
BUNDLE_SIG = bytes.fromhex("8b1202b96a612038727b930214d7a03213f5b9e6efae3318ee3b2dce24b36aae")


def read_7bit(data, pos):
    res = shift = 0
    while True:
        b = data[pos]
        pos += 1
        res |= (b & 0x7f) << shift
        if not (b & 0x80):
            return res, pos
        shift += 7


def main():
    ap = argparse.ArgumentParser(prog="dotnet-bundle", description="Extract a .NET single-file bundle.")
    ap.add_argument("host", help="the single-file host .exe")
    ap.add_argument("-o", "--out", required=True, help="output directory")
    ap.add_argument("--all", action="store_true", help="extract every file, not just the app's own")
    a = ap.parse_args()

    data = open(a.host, "rb").read()
    sig = data.find(BUNDLE_SIG)
    if sig < 8:
        sys.exit("no .NET single-file bundle signature found (not a single-file host?)")
    header_off = struct.unpack_from("<q", data, sig - 8)[0]
    if not (0 < header_off < len(data)):
        sys.exit(f"bundle header offset out of range: {header_off:#x}")

    pos = header_off
    major, minor, num = struct.unpack_from("<III", data, pos)
    pos += 12
    bid_len, pos = read_7bit(data, pos)
    bundle_id = data[pos:pos + bid_len].decode("utf-8", "replace")
    pos += bid_len
    if major >= 2:
        pos += 40  # deps.json (off+size), runtimeconfig.json (off+size), flags
    print(f"dotnet-bundle: v{major}.{minor}, {num} files, id={bundle_id}", file=sys.stderr)

    os.makedirs(a.out, exist_ok=True)
    stem = re.sub(r"\.exe$", "", os.path.basename(a.host), flags=re.I).lower()
    n = 0
    for _ in range(num):
        offset, size = struct.unpack_from("<qq", data, pos)
        pos += 16
        comp = 0
        if major >= 6:
            comp = struct.unpack_from("<q", data, pos)[0]
            pos += 8
        pos += 1  # file type
        plen, pos = read_7bit(data, pos)
        rel = data[pos:pos + plen].decode("utf-8", "replace")
        pos += plen
        base = os.path.basename(rel.replace("\\", "/")) or f"file_{n}"
        if not a.all and stem not in base.lower():
            continue
        blob = data[offset:offset + (comp or size)]
        out = os.path.join(a.out, base)
        if comp:
            try:
                blob = zlib.decompress(blob, -15)
            except zlib.error:
                out += ".deflate"
                print(f"dotnet-bundle: {base}: inflate failed, wrote raw compressed bytes", file=sys.stderr)
        with open(out, "wb") as f:
            f.write(blob)
        print(f"dotnet-bundle: {base} ({len(blob)} B) -> {out}", file=sys.stderr)
        n += 1
    print(f"dotnet-bundle: wrote {n} file(s) to {a.out}" + ("" if a.all else " (app files only; --all for everything)"), file=sys.stderr)


if __name__ == "__main__":
    main()
