# EasyRE-Agent settings. The setup script fills this in for you.

# Which model profile to use (see config/backends.toml or `easyre profiles`)
EASYRE_PROFILE=claude-opus
# Optional: override the model of EASYRE_PROFILE (only that profile)
EASYRE_MODEL=
# Default time budget per task, in minutes
EASYRE_BUDGET_MIN=120

# Toolchain modules baked into the image (wine is always included).
# all = every module (~8 GB image). For a smaller image list a subset of:
#   core, die, ghidra, dotnet, jvm, python, js, autoit, wasm, angr (see toolchain/README.md)
# Rebuild after changing: docker compose build
EASYRE_TOOLS=all

# Claude subscription token (from `easyre login claude`) or Claude API key
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# OpenAI API key (profile openai-api or Codex)
OPENAI_API_KEY=

# OpenRouter key (profile openrouter)
OPENROUTER_API_KEY=

# Google Gemini key from aistudio.google.com (profile gemini)
GEMINI_API_KEY=

# Show agent details in hint mode (spoils the answer)
EASYRE_VERBOSE=
